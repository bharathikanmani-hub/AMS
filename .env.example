# ============================================================
# AttendAI - AI-Powered Classroom Attendance Management System
# Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ---- Flask ----
FLASK_SECRET_KEY=CHANGE_ME_to_a_random_string_at_least_32_chars
FLASK_ENV=development
FLASK_DEBUG=1

# ---- Database (MySQL 8) ----
DB_MODE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=classroom_attendance
DB_USER=root
DB_PASSWORD=CHANGE_ME

# ---- Email (SMTP - Gmail example) ----
MAIL_EMAIL=your-gmail@gmail.com
MAIL_APP_PASSWORD=your-gmail-app-password
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587

# ---- Attendance Rules ----
ATTENDANCE_COVERAGE_THRESHOLD=0.70
LOW_ATTENDANCE_THRESHOLD=75

# ---- Face Recognition ----
RECOGNITION_THRESHOLD=0.363
PHOTOS_PER_STUDENT=15
CAPTURE_DELAY_SECONDS=1.0

# --- AttendAI options ---
# true = attendance can only be taken during the class's timetable period (+/- 10 minutes)
ENFORCE_TIMETABLE=false
# true = print password-reset codes in the server window when e-mail is not configured (testing only)
MAIL_DEV_PRINT_OTP=true
